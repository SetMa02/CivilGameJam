  m_Name: Page_01_Intro_Drought
  m_EditorClassIdentifier: Assembly-CSharp::CivilGame.Book.ManualPageData
  _leftPageTitle: "\u0418\u041D\u0421\u0422\u0420\u0423\u041A\u0426\u0418\u042F \u0421\u041C\u041E\u0422\u0420\u0418\u0422\u0415\u041B\u042F"
  _leftPageIllustration: {fileID: 0}
  _leftPageContent: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C \u043D\u0430 \u043C\u0430\u044F\u043A, \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044C.\n\n\u0412\u0430\u0448\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u2014 \u0432\u0435\u0441\u0442\u0438 \u043A\u0440\u0443\u0433\u043B\u043E\u0441\u0443\u0442\u043E\u0447\u043D\u043E\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 \u0437\u0430 \u0441\u0435\u043A\u0442\u043E\u0440\u0430\u043C\u0438 \u043E\u0441\u0442\u0440\u043E\u0432\u0430.\n\n\u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u0435\u043A\u0442\u043E\u0440 \u043F\u043E\u0434\u0432\u0435\u0440\u0436\u0435\u043D \u0441\u0442\u0438\u0445\u0438\u0439\u043D\u044B\u043C \u0443\u0433\u0440\u043E\u0437\u0430\u043C. \u0421\u0432\u043E\u0435\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0432\u044B\u044F\u0432\u043B\u044F\u0439\u0442\u0435 \u041F\u0420\u0415\u0414\u041F\u041E\u0421\u042B\u041B\u041A\u0418, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044C \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u0437\u043E\u043D.\n\n\u041F\u043E\u043C\u043D\u0438\u0442\u0435: \u043F\u043E\u043B\u043D\u043E\u0435 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u0441\u0435\u043A\u0442\u043E\u0440\u0430 \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442 \u043A \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u0435!"
  _rightPageTitle: "\u0423\u0413\u0420\u041E\u0417\u0410: \u0417\u0410\u0421\u0423\u0425\u0410"
  _rightPageIllustration: {fileID: 0}
  _rightPageContent: "\u0417\u043E\u043D\u044B \u0440\u0438\u0441\u043A\u0430: \u0421\u0442\u0435\u043F\u044C, \u041B\u0435\u0441\n\n\u042D\u0442\u0430\u043F\u044B \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F:\n\u2022 \u042D\u0442\u0430\u043F 1: \u041F\u043E\u0436\u0435\u043B\u0442\u0435\u043D\u0438\u0435 \u043B\u0438\u0441\u0442\u044C\u0435\u0432 \u0438 \u0442\u0440\u0430\u0432\u044B. \u041F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u0430\u044F \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0432\u043E\u0437\u0434\u0443\u0445\u0430.\n\u2022 \u042D\u0442\u0430\u043F 2: \u0412\u044B\u0441\u044B\u0445\u0430\u043D\u0438\u0435 \u0432\u0435\u0442\u043E\u043A, \u043E\u0433\u043E\u043B\u0435\u043D\u0438\u0435 \u0437\u0435\u043C\u043B\u0438, \u043C\u0435\u043B\u043A\u0438\u0435 \u0442\u0440\u0435\u0449\u0438\u043D\u044B \u043F\u043E\u0447\u0432\u044B.\n\u2022 \u042D\u0442\u0430\u043F 3: \u041F\u043E\u043B\u043D\u0430\u044F \u0433\u0438\u0431\u0435\u043B\u044C \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438. \u041D\u0435\u043E\u0431\u0440\u0430\u0442\u0438\u043C\u043E\u0435 \u043E\u043F\u0443\u0441\u0442\u044B\u043D\u0438\u0432\u0430\u043D\u0438\u0435.\n\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F: \u041E\u0440\u043E\u0448\u0435\u043D\u0438\u0435, \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u0432\u043E\u0434\u043E\u0441\u0442\u043E\u043A\u0430."
  _pageNumberText: 
