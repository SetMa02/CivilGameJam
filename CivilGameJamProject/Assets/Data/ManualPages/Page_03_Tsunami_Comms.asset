  m_Name: Page_03_Tsunami_Comms
  m_EditorClassIdentifier: Assembly-CSharp::CivilGame.Book.ManualPageData
  _leftPageTitle: "\u0423\u0413\u0420\u041E\u0417\u0410: \u0426\u0423\u041D\u0410\u041C\u0418"
  _leftPageIllustration: {fileID: 0}
  _leftPageContent: "\u0417\u043E\u043D\u044B \u0440\u0438\u0441\u043A\u0430: \u041C\u043E\u0440\u0435\n\n\u042D\u0442\u0430\u043F\u044B \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F:\n\u2022 \u042D\u0442\u0430\u043F 1: \u041C\u043E\u0440\u0441\u043A\u043E\u0435 \u0437\u0435\u043C\u043B\u0435\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u0435, \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0440\u0435\u0437\u043A\u0438\u0439 \u043E\u0442\u043B\u0438\u0432 \u0432\u043E\u0434\u044B \u043E\u0442 \u0431\u0435\u0440\u0435\u0433\u0430.\n\u2022 \u042D\u0442\u0430\u043F 2: \u0413\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u0430\u044F \u043F\u0440\u0438\u043B\u0438\u0432\u043D\u0430\u044F \u0432\u043E\u043B\u043D\u0430, \u0437\u0430\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u0435 \u0431\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0439 \u043B\u0438\u043D\u0438\u0438.\n\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F: \u041F\u043E\u0434\u043D\u044F\u0442\u0438\u0435 \u0448\u0442\u043E\u0440\u043C\u043E\u0432\u044B\u0445 \u0434\u0430\u043C\u0431, \u0441\u0440\u043E\u0447\u043D\u0430\u044F \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u044F \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u044C\u044F."
  _rightPageTitle: "\u0421\u0412\u042F\u0417\u042C \u0418 \u0421\u041D\u0410\u0411\u0416\u0415\u041D\u0418\u0415"
  _rightPageIllustration: {fileID: 0}
  _rightPageContent: "\u0412 \u0445\u043E\u043B\u043B\u0435 \u043C\u0430\u044F\u043A\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u044D\u043A\u0441\u0442\u0440\u0435\u043D\u043D\u043E\u0439 \u0441\u0432\u044F\u0437\u0438.\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0434\u043B\u044F \u0441\u0432\u044F\u0437\u0438 \u0441\u043E \u0448\u0442\u0430\u0431\u043E\u043C \u0438 \u0437\u0430\u043A\u0430\u0437\u0430 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0433\u043E \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F.\n\n\u0417\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0451\u043D\u043D\u0443\u044E \u0443\u0433\u0440\u043E\u0437\u0443 \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442\u0441\u044F \u043F\u0440\u0435\u043C\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430."
