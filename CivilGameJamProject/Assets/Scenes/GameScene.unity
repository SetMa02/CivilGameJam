  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0417\u043E\u043D\u044B \u0440\u0438\u0441\u043A\u0430: \u0421\u0442\u0435\u043F\u044C, \u041B\u0435\u0441\n\n\u042D\u0442\u0430\u043F\u044B \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F:\n\u2022 \u042D\u0442\u0430\u043F 1: \u041B\u0451\u0433\u043A\u0438\u0439 \u0434\u044B\u043C\u043E\u043A \u043D\u0430\u0434 \u043A\u0440\u043E\u043D\u0430\u043C\u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432 \u0438\u043B\u0438 \u0441\u0443\u0445\u043E\u0439 \u0442\u0440\u0430\u0432\u043E\u0439.\n\u2022 \u042D\u0442\u0430\u043F 2: \u041E\u0447\u0430\u0433\u043E\u0432\u044B\u0435 \u044F\u0437\u044B\u043A\u0438 \u043F\u043B\u0430\u043C\u0435\u043D\u0438, \u043B\u043E\u043A\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043E\u0433\u043E\u043D\u044C.\n\u2022 \u042D\u0442\u0430\u043F 3: \u0412\u0435\u0440\u0445\u043E\u0432\u043E\u0439 \u043D\u0435\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0439 \u043F\u043E\u0436\u0430\u0440. \u041A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0443\u0433\u0440\u043E\u0437\u0430.\n\n\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F: \u041B\u043E\u043A\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F \u043E\u0447\u0430\u0433\u0430, \u0432\u044B\u0437\u043E\u0432 \u043F\u043E\u0436\u0430\u0440\u043D\u043E\u0439 \u0430\u0432\u0438\u0430\u0446\u0438\u0438."
  m_isRightToLeft: 0
